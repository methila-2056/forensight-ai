# FORENSIGHT AI — configuration (copy to .env and adjust if needed)
# Architecture v1.1, Phase 0 defaults.

APP_NAME=FORENSIGHT AI
APP_VERSION=0.1.0

# SQLite database location (relative paths resolve against backend/)
DATABASE_URL=sqlite:///./data/foresight.db

# Raw evidence storage root (write-once; application logic never rewrites raw bytes)
EVIDENCE_STORE_DIR=./evidence_store

# Upload policy (enforced from Phase 1 onward)
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=csv,json,txt,log,zip

# ML reproducibility (Architecture v1.1 §ML)
ANOMALY_THRESHOLD=0.72
RANDOM_STATE=42

# Frontend dev origins
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
