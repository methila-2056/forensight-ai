# FORENSIGHT AI — configuration (copy to .env and adjust if needed)
# Architecture v1.7 — Phases 0–5 defaults.

APP_NAME=FORENSIGHT AI
APP_VERSION=0.1.0

# SQLite database location (relative paths resolve against backend/)
DATABASE_URL=sqlite:///./data/foresight.db

# Raw evidence storage root (write-once; application logic never rewrites raw bytes)
EVIDENCE_STORE_DIR=./evidence_store

# Upload policy (enforced from Phase 1 onward)
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=csv,json,txt,log,zip

# Parsing resource limit (Phase 2): a single processing run reads at most this many
# records; the remainder is reported as a warning and the run is marked Partial.
MAX_RECORDS_PER_RUN=200000

# ------------------------------------------------------------------
# Automated analysis (Phase 3) — Architecture §9 Strategy A
# ------------------------------------------------------------------

# Fixed detection threshold on the min-max normalized window anomaly score.
ANOMALY_THRESHOLD=0.72
# IsolationForest seed — identical runs give identical scores.
RANDOM_STATE=42

# Length of the non-overlapping feature windows (floor-aligned minutes).
ANALYSIS_WINDOW_MINUTES=5
# Dual gate: a window is anomalous only when normalized score >= ANOMALY_THRESHOLD
# AND raw score < mean - ML_Z_SIGMAS * std of the case's scored windows.
ML_Z_SIGMAS=2.0
# The model abstains (no ML findings, reason recorded) below this many windows.
ML_MIN_WINDOWS=8
ML_N_ESTIMATORS=200
# IsolationForest contamination hint (only relevant when the model actually fits).
ML_CONTAMINATION=0.1

# ------------------------------------------------------------------
# Rule engine (Phase 3) — Architecture §10; disable any rule with
# RULE_<ID>_ENABLED=false (e.g. RULE_AUTH003_ENABLED=false).
# ------------------------------------------------------------------
RULE_MAX_FINDINGS_PER_RULE=10
RULE_AUTH001_MIN_FAILURES=3
RULE_AUTH001_WINDOW_MINUTES=15
RULE_AUTH002_MIN_EXTERNAL_LOGINS=3
RULE_AUTH003_WINDOW_SECONDS=60
RULE_FILE001_MIN_MODIFICATIONS=6
RULE_FILE001_WINDOW_MINUTES=15
RULE_FILE001_HIGH_MIN=15
RULE_FILE002_MIN_RENAMES=3
RULE_FILE002_WINDOW_MINUTES=10
RULE_NET001_MIN_CONNECTIONS=2
RULE_NET001_WINDOW_MINUTES=15

# ------------------------------------------------------------------
# Cross-source correlation, timeline, evidence graph (Phase 4)
# Architecture §11/§12 — defaults are the documented spec values
# ------------------------------------------------------------------

# Two events are considered for correlation when they are at most this many
# seconds apart. Undated events are never correlated.
CORRELATION_WINDOW_SECONDS=300

# Deterministic additive confidence weights (sum to 1.0; never a probability).
CORRELATION_WEIGHT_SAME_HOST=0.30
CORRELATION_WEIGHT_SAME_USER=0.30
CORRELATION_WEIGHT_TIME_WINDOW=0.25
CORRELATION_WEIGHT_SAME_SOURCE_IP=0.15

# Reconstructed timeline: ±context minutes around flagged events, and the cap
# on rendered entries (truncation is reported in the response).
TIMELINE_CONTEXT_MINUTES=2
TIMELINE_MAX_ENTRIES=500

# Evidence graph payload caps (beyond the caps the response sets `truncated`
# and always includes a table fallback).
MAX_GRAPH_NODES=200
MAX_GRAPH_EDGES=500

# Frontend dev origins
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ------------------------------------------------------------------
# Investigation assistant (Phase 5) — Architecture §13 (deterministic)
# ------------------------------------------------------------------

# Longest accepted question (shorter is better for a retrieval-first tool).
ASSISTANT_MAX_QUESTION_LENGTH=1000
# Default number of history rows returned (1–500, newest first).
ASSISTANT_HISTORY_LIMIT=100
# Maximum ranked findings/events/correlations cited in a single answer.
ASSISTANT_TOP_N=10
